//Consultas específicas por colección
//Usuarios
	db.Usuarios.find({fechaRegistroUsuario: {$gte: new Date("2024-01-01")}})
	db.Usuarios.find({nickname: /^c/i})
	db.Usuarios.find({telefono: /^318/})
	db.Usuarios.find({correoUsuario: /gmail\.com$/i})
	db.Usuarios.find({$or: [{estadoUsuario: "Activo"}, {estdoUsuario: "Activo"}]}, {nombreUsuario: 1, fechaRegistroUsuario: 1})
	db.Usuarios.find({rolUsuario: "Empleado", fechaRegistroUsuario: {$lt: new Date("2023-01-01")}, $or: [{estadoUsuario: "Activo"}, {estdoUsuario: "Activo"}]})
	db.Usuarios.countDocuments({rolUsuario: "Administrador"})
	
//Producto
	db.productos.find({"unidadProducto": "kg" })
	db.productos.find({nombreProducto: /Harina/i })
	db.productos.countDocuments()
	db.productos.distinct("unidadProducto")
	db.productos.find({ "_id": { $in: ["000020B","000030C"] } })
	db.productos.aggregate([{ $sample: { size: 5 } }])
	db.productos.find({ nombreProducto: { $exists: true, $ne: "" } }).limit(20)

//Inventario
	db.inventarios.find({ "producto.idProducto": "000020B" })
	db.inventarios.find({ cantidadInventario: { $lt: 20 } })
	db.inventarios.aggregate([{ $group:{ _id:"$bodega", total: {$sum:"$cantidadInventario"} }}])
	db.inventarios.countDocuments()
	db.inventarios.find({ "fechaActualizacion": { $gte: new Date("2025-01-01") } })
	db.inventarios.find({ "producto.nombreProducto": /HARINA/i }).limit(50)
	db.inventarios.find({ "producto.idProducto": { $exists: true } }).sort({ cantidadInventario: -1 }).limit(5)

//Movimiento
	db.movimientos.find({ tipoMovimiento: "FACTCOMP" })
	db.movimientos.find({ tipoMovimiento: "FACTVENT" })
	db.movimientos.aggregate([{$match: {fechaMovimiento: {$gte: new Date("2025-01-01")}}}, {$group: {_id: "$tipoMovimiento", total: {$sum: "$cantidadNetaMovimiento"}}}])
	db.movimientos.find({ "inventario.idInventario": "000020B_in_BODEGA1" })
	db.movimientos.countDocuments({ tipoMovimiento: "ENSAMBLE" })
	db.movimientos.find({ cantidadNetaMovimiento: { $gt: 0 } }).limit(20)
	db.movimientos.aggregate([{ $sort:{ fechaMovimiento:-1 } },{ $limit:10 }])

//Compra
	db.compras.find({ nitProveedorFK: "890400372" })
	db.compras.aggregate([{ $group: { _id: "$nitProveedorFK", totalComprado: { $sum:"$costoTotalCompra" } } }])
	db.compras.find({ costoTotalCompra: { $gt: 100000 } })
	db.compras.find({ idMovimientoFK: { $exists: true } })
	db.compras.countDocuments()
	db.compras.find().sort({ costoTotalCompra: -1 }).limit(5)
	db.compras.find({ $expr: { $gt: ["$costoTotalCompra", { $multiply: ["$costoUnitarioCompra", 1] }] } })

//Venta
	db.ventas.find({ nitClienteFK: "901234567" })
	db.ventas.aggregate([{ $group: { _id: "$nitClienteFK", totalVenta: { $sum: "$costoTotalVenta" } } }])
	db.ventas.find({ costoTotalVenta: { $gt: 50000 } })
	db.ventas.countDocuments()
	db.ventas.find({ idMovimientoFK: { $exists: true } })
	db.ventas.find().sort({ costoTotalVenta: -1 }).limit(10)
	db.ventas.aggregate([{ $project:{ idMovimientoFK:1, costoTotalVenta:1 } }])

//Proveedor
	db.proveedores.find({ nombreProveedor: /Castillo/i })
	db.proveedores.countDocuments()
	db.proveedores.aggregate([{ $lookup:{ from:"compras", localField:"nitProveedor", foreignField:"nitProveedorFK", as:"compras" } },{ $project:{ nitProveedor:1, nombreProveedor:1, comprasCount: { $size: "$compras" } } }])
	db.proveedores.find({ "compras.0": { $exists: true } }) // si embebiste compras
	db.proveedores.find().sort({ nombreProveedor: 1 }).limit(20)
	db.proveedores.find({ nitProveedor: { $in: ["890400372","800123456"] } })

//Cliente
	db.clientes.find({ nombreCliente: /Panaderia/i })
	db.clientes.countDocuments()
	db.clientes.aggregate([{ $lookup:{ from:"ventas", localField:"nitCliente", foreignField:"nitClienteFK", as:"ventas" } },{ $project:{ nitCliente:1, nombreCliente:1, ventasTotal: { $sum: "$ventas.costoTotalVenta" } } }])
	db.clientes.find({ "ventas.0": { $exists: true } })
	db.clientes.find().sort({ nombreCliente: 1 })
	db.clientes.find({ nitCliente: { $exists: true } }).limit(20)

//Ensamble
	db.ensambles.find({ "productoPadre.id": "000020B" })
	db.ensambles.find({ razonHijosPorPadre: { $gt: 1 } })
	db.ensambles.aggregate([{ $lookup:{ from:"productos", localField:"productoHijo.id", foreignField:"_id", as:"hijo" } },{ $project:{ _id:1, productoPadre:1, hijoNombre: { $arrayElemAt:["$hijo.nombreProducto",0] } } }])
	db.ensambles.countDocuments()
	db.ensambles.find().sort({ razonHijosPorPadre: -1 }).limit(10)
	db.ensambles.find({ "productoHijo.nombre": /masa/i })

//Modificaciones
//Actualizar precio/atributo (ejemplo) - productos
db.productos.updateOne({_id:"000020B"}, { $set: { unidadProducto: "kg" } });

//Incrementar stock en inventarios
db.inventarios.updateMany({}, { $inc: { cantidadInventario: 10 }});

//Actualizar fecha de actualización de un inventario
db.inventarios.updateOne({ _id: "000020B_in_BODEGA1" }, { $set: { fechaActualizacion: new Date() }});

//Corregir nombre de proveedor
db.proveedores.updateOne({ nitProveedor: "890400372" }, { $set: { nombreProveedor: "Rafael Del Castillo & CÍA" }});

//Marcar cliente inactivo (ejemplo: agregar campo)
db.clientes.updateOne({ nitCliente: "901234567" }, { $set: { estadoCliente: "Inactivo" }});

//Eliminaciones
//Eliminar producto si NO existe en inventarios (comprobación manual)
if (db.inventarios.countDocuments({ "producto.idProducto": "000999X" }) === 0) {
  db.productos.deleteOne({ _id: "000999X" })
} else {
  print("No se puede eliminar: existen inventarios asociados.")}

//Consultas cruzadas entre colecciones
//Ventas y productos
db.ventas.aggregate([
  { $lookup: { from: "productos", localField: "idProductoFK", foreignField: "_id", as: "producto_detalle" } },
  { $unwind: { path: "$producto_detalle", preserveNullAndEmptyArrays: true } },
  { $project: { idMovimientoFK:1, costoTotalVenta:1, "producto_detalle.nombreProducto":1 } }
])

//Compras por proveedor con detalle producto
db.compras.aggregate([
  { $lookup:{ from:"movimientos", localField:"idMovimientoFK", foreignField:"_id", as:"mov" } },
  { $unwind:"$mov" },
  { $lookup:{ from:"inventarios", localField:"mov.inventario.idInventario", foreignField:"_id", as:"inv" } },
  { $unwind:{ path:"$inv", preserveNullAndEmptyArrays:true } },
  { $lookup:{ from:"productos", localField:"inv.producto.idProducto", foreignField:"_id", as:"producto" } },
  { $unwind:{ path:"$producto", preserveNullAndEmptyArrays:true } },
  { $project:{ idMovimientoFK:1, costoTotalCompra:1, proveedor: "$nitProveedorFK", producto: "$producto.nombreProducto" } }
])


//Producto padre con movimientos de hijos
db.ensambles.aggregate([
  { $lookup:{ from:"productos", localField:"productoHijo.id", foreignField:"_id", as:"hijo" } },
  { $lookup:{ from:"inventarios", localField:"productoHijo.id", foreignField:"producto.idProducto", as:"inv_hijo" } },
  { $project:{ idEnsamble:1, productoPadre:1, hijo: { $arrayElemAt: ["$hijo.nombreProducto",0] }, inventariosHijo: "$inv_hijo" } }
])
